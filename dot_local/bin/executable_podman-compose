#!/bin/sh
# ~/.local/bin/podman-compose
# Wrapper qui redirige vers le podman-compose de l'hôte, quel que soit
# le contexte d'exécution (Flatpak, Distrobox, ou natif).
# Sur macOS, il n'y a pas de Podman : on redirige vers `docker compose`.
# Chemin absolu obligatoire : ce wrapper porte le même nom que la vraie
# commande, une recherche dans le PATH peut le relancer lui-même en boucle.

REAL=/usr/bin/podman-compose

if [ "$(uname -s)" = "Darwin" ]; then
    exec docker compose "$@"

elif [ -f /.flatpak-info ]; then
    exec flatpak-spawn --host "$REAL" "$@"

elif [ -n "$CONTAINER_ID" ] || [ -f /run/.containerenv ]; then
    exec distrobox-host-exec "$REAL" "$@"

else
    [ -x "$REAL" ] || { echo "podman-compose introuvable : $REAL" >&2; exit 127; }
    exec "$REAL" "$@"
fi
