#!/bin/sh
# ~/.local/bin/podman-compose
# Wrapper qui redirige vers le podman-compose de l'hôte, quel que soit
# le contexte d'exécution (Flatpak, Distrobox, ou natif).

if [ -f /.flatpak-info ]; then
    # On est dans un sandbox Flatpak
    exec flatpak-spawn --host podman-compose "$@"

elif [ -n "$CONTAINER_ID" ] || [ -f /run/.containerenv ]; then
    # On est dans une Distrobox (ou un container OCI générique)
    exec distrobox-host-exec podman-compose "$@"

else
    # Exécution native sur l'hôte
    exec podman-compose "$@"
fi

