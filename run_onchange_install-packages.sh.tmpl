#!/bin/sh
# Installe les paquets de dot_config/packages/<famille>.txt avec
# dot_local/bin/executable_install-packages (détection de la distribution à
# l'exécution). Script et listes sont pris dans le dépôt source, pour ne pas
# dépendre de l'ordre dans lequel chezmoi applique les fichiers.
# chezmoi relance ce script quand l'un d'eux change (empreintes ci-dessous).
# {{ include "dot_local/bin/executable_install-packages" | sha256sum }}
# {{ range glob (joinPath .chezmoi.sourceDir "dot_config/packages/*.txt") }}{{ include . | sha256sum }} {{ end }}

export PACKAGES_DIR={{ joinPath .chezmoi.sourceDir "dot_config/packages" | squote }}
exec bash {{ joinPath .chezmoi.sourceDir "dot_local/bin/executable_install-packages" | squote }}
